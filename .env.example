REACT_APP_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
API_PORT=4000

# Backend-only Supabase persistence. Keep the service role key out of the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ENABLED=true
SUPABASE_ALERTS_TABLE=alerts
SUPABASE_ALERT_EVENTS_TABLE=alert_events
SUPABASE_WALLETS_TABLE=wallets
SUPABASE_EXCHANGE_CONNECTIONS_TABLE=exchange_connections
SUPABASE_CUSTODY_TABLE=custody_positions
SUPABASE_DCA_PLANS_TABLE=dca_plans
SUPABASE_DCA_EXECUTIONS_TABLE=dca_executions

# Backend-only secret encryption. Required before storing exchange API keys.
SECRET_ENCRYPTION_KEY=replace_with_a_long_random_server_secret

# Frontend Supabase Auth. This is the public anon/publishable key, not the service role key.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_public_anon_or_publishable_key

# Alert worker
ALERT_WORKER_ENABLED=true
ALERT_WORKER_INTERVAL_MS=60000
ALERT_WORKER_COOLDOWN_MS=900000
ALERT_WEBHOOK_URL=

# DCA schedule worker. It prepares due orders; wallet signature is still required.
DCA_WORKER_ENABLED=true
DCA_WORKER_INTERVAL_MS=300000

# Research feed. Leave empty to use default RSS sources.
RESEARCH_FEED_CACHE_MS=300000
RESEARCH_FEED_LIMIT_PER_SOURCE=6
# RESEARCH_FEED_SOURCES=[{"id":"coindesk","name":"CoinDesk","tag":"macro","url":"https://www.coindesk.com/arc/outboundfeeds/rss/"}]

# Macro signals
MACRO_SIGNALS_CACHE_MS=120000
MACRO_FUTURES_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,ADAUSDT

# Optional overrides. The defaults already point to the local backend through CRA proxy.
REACT_APP_ALERTS_ENDPOINT=/api/alerts
REACT_APP_CUSTODY_ENDPOINT=/api/custody
REACT_APP_EXECUTIONS_ENDPOINT=/api/execute-dca
REACT_APP_DCA_SCHEDULE_ENDPOINT=/api/dca-plans
REACT_APP_DCA_STABLE=USDC

# 0x Swap API backend proxy
ZEROX_QUOTE_ENDPOINT=https://api.0x.org/swap/allowance-holder/quote
ZEROX_API_KEY=
# AllowanceHolder contracts are validated in code.

# Allowed browser origins for the API (comma-separated).
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
