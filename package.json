{
  "name": "cryptoline",
  "version": "1.0.0",
  "private": true,
  "proxy": "http://localhost:4000",
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@walletconnect/ethereum-provider": "^2.18.0",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^5.8.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-router-dom": "^6.30.3",
    "react-scripts": "5.0.1",
    "recharts": "^2.12.7"
  },
  "scripts": {
    "start": "concurrently -n api,web -c cyan,green \"npm run start:api\" \"npm run start:web\"",
    "start:web": "cross-env NODE_OPTIONS=--openssl-legacy-provider GENERATE_SOURCEMAP=false DANGEROUSLY_DISABLE_HOST_CHECK=true react-scripts start",
    "start:api": "node server/index.js",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider GENERATE_SOURCEMAP=false react-scripts build",
    "test": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts test",
    "eject": "react-scripts eject"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
